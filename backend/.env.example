PORT=4000
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put your own user and password in it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster
MONGODB_DB=hisaab
# Clerk Dashboard > API keys > Secret key (starts with sk_). Keep it secret: only here and in the host settings (Render).
CLERK_SECRET_KEY=
